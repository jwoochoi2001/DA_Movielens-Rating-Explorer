# 저장소 안에서는 텍스트 파일을 항상 LF 로 정규화한다.
* text=auto eol=lf

# 명시적 텍스트 (LF)
*.py     text eol=lf
*.md     text eol=lf
*.txt    text eol=lf
*.csv    text eol=lf
*.tsv    text eol=lf
*.json   text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.cfg    text eol=lf
*.ini    text eol=lf
.gitattributes text eol=lf
.gitignore     text eol=lf

# 바이너리 (정규화 금지)
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.pdf    binary
*.zip    binary
*.xlsx   binary
*.parquet binary
